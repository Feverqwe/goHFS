{
  "name": "folderpage",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:dist": "del-cli ./dist/**",
    "clean:www": "del-cli --force ../assets/www",
    "copy:dist": "ncp ./dist ../assets/www",
    "build": "rspack build --mode production",
    "dev": "rspack build --mode development --watch",
    "release": "npm run clean:dist && npm run build && npm run clean:www && npm run copy:dist",
    "tsc": "tsc --noEmit",
    "lint": "eslint ./src && npm run prettier",
    "prettier": "prettier --check ./src",
    "prettier:fix": "prettier --write ./src",
    "lint:fix": "eslint --fix ./src && npm run prettier:fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/cache": "^11.10.5",
    "@emotion/react": "^11.6.0",
    "@emotion/styled": "^11.6.0",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@tanstack/react-query": "^5.101.4",
    "@types/qrcode": "^1.5.5",
    "filesize": "^11.0.13",
    "hls.js": "^1.6.16",
    "lodash": "^4.17.21",
    "mime": "^4.0.1",
    "path-browserify": "^1.0.1",
    "qrcode": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "video.js": "^8.23.9"
  },
  "devDependencies": {
    "@rspack/cli": "^1.5.0",
    "@rspack/core": "^1.5.0",
    "@types/lodash": "^4.17.7",
    "@types/path-browserify": "^1.0.0",
    "@types/react-dom": "^19.0.2",
    "@gravity-ui/eslint-config": "^4.3.2",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.0",
    "ncp": "^2.0.0",
    "prettier": "^3.0.2",
    "typescript": "^6.0.3"
  }
}
