{
  "name": "folderpage",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:dist": "del-cli ./dist/**",
    "clean:www": "del-cli --force ../assets/www",
    "copy:dist": "ncp ./dist ../assets/www",
    "build": "rspack build --mode production",
    "dev": "rspack build --mode development --watch",
    "release": "npm run clean:dist && npm run build && npm run clean:www && npm run copy:dist",
    "storybook": "storybook dev -p 6006 --no-open --no-version-updates",
    "build-storybook": "storybook build",
    "tsc": "tsc --noEmit",
    "lint": "eslint ./src ./.storybook && npm run prettier",
    "prettier": "prettier --check ./src ./.storybook",
    "prettier:fix": "prettier --write ./src ./.storybook",
    "lint:fix": "eslint --fix ./src ./.storybook && npm run prettier:fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/qrcode": "^1.5.6",
    "filesize": "^11.0.22",
    "hls.js": "^1.6.17",
    "lodash": "^4.18.1",
    "mime": "^4.1.0",
    "path-browserify": "^1.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "video.js": "^8.23.9"
  },
  "devDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@gravity-ui/eslint-config": "^4.3.2",
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "@storybook/react-vite": "^10.5.7",
    "@types/lodash": "^4.17.25",
    "@types/path-browserify": "^1.0.3",
    "@types/react-dom": "^19.2.4",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.5",
    "ncp": "^2.0.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.7",
    "typescript": "^6.0.3",
